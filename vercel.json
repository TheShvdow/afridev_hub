{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "NX_DAEMON=false NX_NO_CLOUD=true npx nx build web --configuration=production",
  "outputDirectory": "dist/apps/web/browser",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.csr.html" }]
}
