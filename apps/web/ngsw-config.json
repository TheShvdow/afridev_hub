{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "pwa-icons",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/icons/**",
          "/assets/images/logo.png"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "!/assets/icons/**",
          "!/assets/**/*.mp4",
          "!/assets/**/*.webm",
          "!/assets/**/*.ogg",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "hero-poster",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/images/hero_img.png"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-forum",
      "urls": ["/api/forum/posts"],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "5m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-projects",
      "urls": ["/api/projects"],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "10m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-jobs",
      "urls": ["/api/jobs"],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "15m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-user-profiles",
      "urls": ["/api/users/**"],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "30m",
        "timeout": "10s",
        "strategy": "performance"
      }
    },
    {
      "name": "api-gamification",
      "urls": [
        "/api/gamification/leaderboard",
        "/api/gamification/badges"
      ],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "1h",
        "timeout": "10s",
        "strategy": "performance"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}
