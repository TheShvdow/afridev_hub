{
  "name": "afridev-hub",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "prisma": {
    "seed": "ts-node -P tsconfig.json -r tsconfig-paths/register prisma/seed.ts"
  },
  "scripts": {
    "start:web": "nx serve web",
    "start:api": "nx serve api",
    "start:all": "nx run-many --target=serve --projects=web,api --parallel",
    "build:web": "nx build web --configuration=production",
    "build:api": "nx build api --configuration=production",
    "build:all": "nx run-many --target=build --all --configuration=production",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --watch",
    "lint": "nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,html,scss,json}\"",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:seed": "ts-node -P tsconfig.json -r tsconfig-paths/register prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema=prisma/schema.prisma",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "prepare": "prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
