# ─────────────────────────────────────────────────────────────────
# AfriDev Hub — Variables d'environnement
# Copier en .env et remplir les vraies valeurs (jamais commiter .env)
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
# Expose Swagger (/api/docs) en production
SWAGGER_ENABLED=false
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:4200
# Origines CORS supplémentaires, séparées par des virgules (ex. l'aperçu Vercel). Facultatif.
CORS_ORIGINS=

# ── Base de données ───────────────────────────────────────────────
#
# DEV / CI  → Neon (serverless Postgres)
#   DATABASE_URL : URL poolée (PgBouncer) — utilisée par l'app NestJS au runtime
#   DIRECT_URL   : URL directe — utilisée par Prisma Migrate (DDL, migrations)
#
#   Neon Dashboard → votre projet → Connection Details
#   Cocher "Connection pooling" pour DATABASE_URL
#   Décocher "Connection pooling" pour DIRECT_URL
#
#   Format : postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# VPS PROD → décommenter les lignes locales ci-dessous et commenter les Neon
#
# --- Neon (dev / CI) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.pooler.eu-central-1.aws.neon.tech/afridev_hub?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.eu-central-1.aws.neon.tech/afridev_hub?sslmode=require

# --- VPS auto-hébergé (prod) ---
# DATABASE_URL=postgresql://afridev:STRONG_PASSWORD@localhost:5432/afridev_hub
# DIRECT_URL=postgresql://afridev:STRONG_PASSWORD@localhost:5432/afridev_hub

# ── Redis ────────────────────────────────────────────────────────
#
# DEV / CI  → Upstash (Redis managed, TLS)
#   Upstash Console → votre base → Details → "ioredis" section
#   Le préfixe rediss:// (double s) active le TLS — ioredis le gère nativement
#
# VPS PROD → décommenter la ligne locale ci-dessous
#
# --- Upstash (dev / CI) ---
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:PORT

# --- VPS auto-hébergé (prod) ---
# REDIS_URL=redis://localhost:6379

REDIS_TTL_ACCESS=900          # 15 minutes en secondes
REDIS_TTL_REFRESH=604800      # 7 jours en secondes

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_VERY_LONG_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_DIFFERENT_FROM_JWT_SECRET
JWT_REFRESH_EXPIRES=7d

# ── OAuth GitHub ──────────────────────────────────────────────────
# Identifiants de l'application OAuth GitHub (Settings → Developer settings →
# OAuth Apps). Le callback déclaré côté GitHub doit être exactement
# GITHUB_CALLBACK_URL : l'API est servie sous le préfixe /api.
# Rappel : l'API refuse de démarrer si ces deux variables sont absentes.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ── OAuth Google (optionnel) ──────────────────────────────────────
# Laisser vide si l'application n'est pas configurée : la route
# /api/auth/google répond alors 503 au lieu de lancer le flux.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── Email — Resend ────────────────────────────────────────────────
# En sandbox (NODE_ENV !== 'production'), aucun email n'est envoyé.
# En production, créer une clé sur resend.com et vérifier votre domaine.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=noreply@afridevhub.com

# ── Cloudflare R2 (stockage fichiers/avatars) ─────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret
CLOUDFLARE_R2_BUCKET_NAME=afridev-hub-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.afridevhub.com

# ── Paiements — agrégateur Bictorys (décision 2026-10-14) ────────
# Sandbox : https://api.test.bictorys.com — Production : https://api.bictorys.com
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=test_public-your_key          # clé publique : charges, statut, remboursement
BICTORYS_PRIVATE_KEY=test_secret-your_key      # clé privée : payouts uniquement (non utilisée en Phase 1)
BICTORYS_WEBHOOK_SECRET=your_webhook_secret    # secret du dashboard webhooks (mode test ET production)
BICTORYS_COUNTRY=SN                            # pays par défaut des charges (SN, CI, BK, ML, TG, BJ)
BICTORYS_MERCHANT_SECRET_CODE=                 # code marchand, requis pour les payouts

# ── Commissions ───────────────────────────────────────────────────
COMMISSION_MENTORING=0.12     # 12%
COMMISSION_COURSES=0.08       # 8%

# ── Throttling ────────────────────────────────────────────────────
THROTTLE_TTL=60000            # 1 minute
THROTTLE_LIMIT=60             # 60 req/min par IP
TRUST_PROXY=1                 # proxys devant l'API (1 sur Render) : l'IP comptée est celle du visiteur

# ── Sentry (monitoring erreurs) ───────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/...
