// ─────────────────────────────────────────────────────────────────
// AfriDev Hub — Prisma Schema
// Phase 1 — MVP (32 entités)
//
// Conventions :
//   - IDs     : uuid() (UUID v4)
//   - Dates   : DateTime, stockées en UTC
//   - Montants: Int en centimes (XOF/NGN → unité de base)
//   - Vote    : polymorphique via entityType + entityId (enum strict)
//   - Tag     : polymorphique via PostTag + ProjectTag (FK valides)
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum VoteEntityType {
  POST
  ANSWER
}

enum VoteValue {
  UP
  DOWN
}

enum ReportEntityType {
  POST
  ANSWER
  PROJECT
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDDEN
  RESTORED
  DISMISSED
  WARNING
  BAN
}

enum JobMode {
  REMOTE
  ONSITE
  HYBRID
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
}

enum JobStatus {
  PENDING_REVIEW // en attente de validation par la modération (FR-28)
  ACTIVE
  REJECTED
  EXPIRED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum PlanType {
  FREE
  PREMIUM
}

// Agrégateur de paiement unique (décision 2026-10-14) : Bictorys.
enum PaymentProvider {
  BICTORYS
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentEntityType {
  MENTOR_SESSION
  RECRUITER_PLAN
  COURSE_ENROLLMENT
}

enum NotificationType {
  NEW_ANSWER
  ANSWER_ACCEPTED
  VOTE_RECEIVED
  MENTION
  REPORT_RESOLVED
  JOB_ALERT
  JOB_APPLICATION
  JOB_REVIEWED
  SYSTEM
  BADGE_AWARDED
}

// ─────────────────────────────────────────────────────────────────
// PAYS — liste fermée proposée en liste déroulante (GET /api/countries)
// Remplie par la migration et le seed depuis apps/api/src/common/countries.ts.
// ─────────────────────────────────────────────────────────────────

enum CountryRegion {
  AFRICA
  DIASPORA
}

model Country {
  code   String        @id // ISO 3166-1 alpha-2 : SN, CI, NG…
  alpha3 String        @unique // ISO 3166-1 alpha-3 : SEN, CIV, NGA…
  name   String // nom en français
  region CountryRegion

  users     User[]
  jobOffers JobOffer[]
  projects  Project[]

  @@index([region, name])
}

// ─────────────────────────────────────────────────────────────────
// AUTH & USER
// ─────────────────────────────────────────────────────────────────

// Niveau d'expérience déclaré par le membre (onboarding).
enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  username           String           @unique
  passwordHash       String?
  displayName        String?
  avatarUrl          String?
  bio                String?          @db.Text
  location           String?
  country            String? // code de la table Country (critère du badge vérifié)
  stack              String[]         @default([]) // technologies déclarées (critère du badge vérifié)
  level              ExperienceLevel? // niveau d'expérience déclaré (onboarding)
  websiteUrl         String?
  githubUsername     String?
  linkedinUsername   String?
  twitterUsername    String?
  reputation         Int              @default(0)
  isVerified         Boolean          @default(false)
  emailNotifications Boolean          @default(true) // FR-18 : emails d'activité désactivables
  isRecruiter        Boolean          @default(false) // profil recruteur activé par le membre (glossaire « Recruteur »)
  companyName        String?
  preferredCurrency  String? // ISO 4217 : devise d'affichage des salaires (FR-30)
  role               UserRole         @default(MEMBER)
  lastSeenAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  countryRef        Country?           @relation(fields: [country], references: [code], onUpdate: Cascade, onDelete: Restrict)
  accounts          Account[]
  posts             Post[]
  answers           Answer[]
  votes             Vote[]
  reports           Report[]
  moderationActions ModerationAction[] @relation("ModeratorActions")
  receivedBadges    UserBadge[]        @relation("ReceivedBadges")
  reputationEvents  ReputationEvent[]
  projects          Project[]
  projectStars      ProjectStar[]
  jobOffers         JobOffer[]
  jobApplications   JobApplication[]
  jobAlerts         JobAlert[]
  recruiterPlan     RecruiterPlan?
  payments          Payment[]
  notifications     Notification[]
  notificationsSent Notification[]     @relation("NotificationActor")
  auditLogs         AuditLog[]

  @@index([email])
  @@index([username])
  @@index([reputation])
}

model Account {
  id                String @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Code de vérification d'email : 6 caractères envoyés par email, stockés en empreinte SHA-256.
model VerificationToken {
  identifier String
  token      String   @unique // empreinte SHA-256 du code, unique
  expires    DateTime
  attempts   Int      @default(0) // essais erronés : au 5e, le code est invalidé

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────
// BADGES & RÉPUTATION
// ─────────────────────────────────────────────────────────────────

model Badge {
  id             String  @id @default(uuid())
  name           String  @unique
  description    String
  icon           String
  condition      String
  slug           String? @unique
  category       String?
  requiredPoints Int     @default(0)

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation("ReceivedBadges", fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

model ReputationEvent {
  id         String   @id @default(uuid())
  userId     String
  delta      Int
  reason     String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────
// TAG — polymorphique via tables de jonction PostTag + ProjectTag
// (FK valides dans les deux sens)
// ─────────────────────────────────────────────────────────────────

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())

  postTags    PostTag[]
  projectTags ProjectTag[]

  @@index([usageCount])
}

// ─────────────────────────────────────────────────────────────────
// FORUM Q&A
// ─────────────────────────────────────────────────────────────────

model Post {
  id             String    @id @default(uuid())
  title          String
  body           String    @db.Text
  userId         String
  isResolved     Boolean   @default(false)
  viewCount      Int       @default(0)
  voteScore      Int       @default(0) // upvotes − downvotes, tenu à jour par ForumListener
  lastActivityAt DateTime  @default(now())
  isHidden       Boolean   @default(false) // masqué par la modération (FR-21)
  hiddenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  Answer[]
  postTags PostTag[]

  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
  @@index([voteScore])
  @@index([lastActivityAt])
  @@index([isHidden])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Answer {
  id         String    @id @default(uuid())
  body       String    @db.Text
  postId     String
  userId     String
  isAccepted Boolean   @default(false)
  voteScore  Int       @default(0)
  isHidden   Boolean   @default(false)
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([isAccepted])
}

// ─────────────────────────────────────────────────────────────────
// VOTE — polymorphique
// entityType ∈ { POST, ANSWER } (enum strict)
// Intégrité référentielle gérée par le service NestJS (pas de FK DB)
// Contrainte d'unicité : un user ne vote qu'une fois par entité
// ─────────────────────────────────────────────────────────────────

model Vote {
  id         String         @id @default(uuid())
  userId     String
  entityType VoteEntityType
  entityId   String
  value      VoteValue
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────
// MODÉRATION
// ─────────────────────────────────────────────────────────────────

model Report {
  id         String           @id @default(uuid())
  userId     String
  entityType ReportEntityType
  entityId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderationActions ModerationAction[]

  @@unique([userId, entityType, entityId]) // FR-20 : un signalement par membre et par contenu
  @@index([status])
  @@index([entityType, entityId])
  @@index([userId])
}

// Cible d'une action de modération : contenu signalé, ou utilisateur banni.
enum ModerationTargetType {
  POST
  ANSWER
  PROJECT
  USER
}

model ModerationAction {
  id          String               @id @default(uuid())
  moderatorId String? // null : action automatique (masquage au seuil de signalements)
  reportId    String?
  entityType  ModerationTargetType
  entityId    String
  action      ModerationActionType
  note        String?
  createdAt   DateTime             @default(now())

  moderator User?   @relation("ModeratorActions", fields: [moderatorId], references: [id])
  report    Report? @relation(fields: [reportId], references: [id])

  @@index([moderatorId])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────
// VITRINE PROJETS
// ─────────────────────────────────────────────────────────────────

model ProjectCategory {
  id   String  @id @default(uuid())
  name String  @unique
  slug String  @unique
  icon String?

  projects Project[]
}

model Project {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique // URL publique : /projects/<slug>
  description    String    @db.Text
  country        String    @default("SN") // code de la table Country
  repoUrl        String
  demoUrl        String?
  userId         String
  categoryId     String?
  githubFullName String? // « owner/repo », extrait de repoUrl
  githubStars    Int       @default(0)
  githubForks    Int       @default(0)
  githubLanguage String?
  githubLastPush DateTime?
  githubSyncedAt DateTime? // dernier import réussi des stats GitHub (FR-23)
  isHidden       Boolean   @default(false) // masqué par la modération (FR-21)
  hiddenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  countryRef  Country          @relation(fields: [country], references: [code], onUpdate: Cascade, onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    ProjectCategory? @relation(fields: [categoryId], references: [id])
  stars       ProjectStar[]
  projectTags ProjectTag[]

  @@index([userId])
  @@index([githubFullName])
  @@index([githubStars])
  @@index([country])
  @@index([createdAt])
}

model ProjectStar {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

// ─────────────────────────────────────────────────────────────────
// JOB BOARD
// ─────────────────────────────────────────────────────────────────

model JobOffer {
  id                   String    @id @default(uuid())
  title                String
  description          String    @db.Text
  company              String
  recruiterId          String
  country              String
  mode                 JobMode
  type                 JobType   @default(FULL_TIME)
  currency             String
  salaryMin            Int
  salaryMax            Int
  stack                String[]
  status               JobStatus @default(PENDING_REVIEW)
  // Salaire converti en USD (entier) pour filtrer entre devises ; recalculé chaque jour.
  salaryMinUsd         Int?
  salaryMaxUsd         Int?
  publishedAt          DateTime? // validation par la modération
  rejectionReason      String?
  expiresAt            DateTime
  expiryReminderSentAt DateTime? // rappel J50 (FR-33)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  countryRef   Country          @relation(fields: [country], references: [code], onUpdate: Cascade, onDelete: Restrict)
  recruiter    User             @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([recruiterId])
  @@index([status])
  @@index([country, mode])
  @@index([expiresAt])
  @@index([salaryMaxUsd])
  @@index([publishedAt])
}

model JobApplication {
  id        String            @id @default(uuid())
  jobId     String
  userId    String
  message   String            @db.Text
  cvUrl     String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  // Informations saisies par le candidat avec sa candidature (toutes facultatives en base :
  // les candidatures antérieures n'en ont pas).
  fullName         String?
  phone            String?
  country          String? // code pays ISO 3166-1 alpha-2 (liste de common/countries.ts)
  city             String?
  linkedinUrl      String?
  githubUrl        String?
  portfolioUrl     String?
  experienceYears  Int?
  availableFrom    DateTime? @db.Date
  expectedSalary   Int? // unités de base, dans expectedCurrency
  expectedCurrency String? // ISO 4217
  stack            String[]  @default([])

  job  JobOffer @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([status])
}

model JobAlert {
  id           String    @id @default(uuid())
  userId       String
  country      String?
  mode         JobMode?
  stack        String[]
  currency     String?
  salaryMin    Int?
  isActive     Boolean   @default(true)
  lastDigestAt DateTime? // dernier récapitulatif hebdomadaire envoyé (FR-32)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// Taux de change par rapport au dollar (open.er-api.com), rafraîchis chaque jour (FR-30).
model ExchangeRate {
  currency  String   @id // ISO 4217
  perUsd    Float // unités de la devise pour 1 USD
  updatedAt DateTime @updatedAt
}

model RecruiterPlan {
  id        String    @id @default(uuid())
  userId    String    @unique
  planType  PlanType  @default(FREE)
  startedAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────
// PAIEMENTS
// ─────────────────────────────────────────────────────────────────

model Payment {
  id          String            @id @default(uuid())
  userId      String
  provider    PaymentProvider
  externalRef String?
  amount      Int // En unités de base (XOF, NGN, KES…)
  currency    String // ISO 4217 : "XOF", "NGN", "KES", "USD"
  status      PaymentStatus     @default(PENDING)
  entityType  PaymentEntityType
  entityId    String
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  commission Commission?

  @@index([userId])
  @@index([status])
  @@index([entityType, entityId])
  @@index([externalRef])
}

model Commission {
  id        String   @id @default(uuid())
  paymentId String   @unique
  amount    Int // Montant prélevé en unités de base
  rate      Float // Ex: 0.12 pour 12%
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// ─────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String?
  message    String
  targetType String?
  targetId   String?
  link       String? // chemin web du contenu concerné (ex. /forum/<id>)
  actorId    String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
